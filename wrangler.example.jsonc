// Copy to wrangler.jsonc (gitignored) and fill in your own values.
{
  "name": "merit-aktiva-mcp",
  "account_id": "<cloudflare-account-id>",
  "main": "src/worker.ts",
  "compatibility_date": "2025-03-10",
  "compatibility_flags": ["nodejs_compat"],
  // only the custom domain should serve this (Cloudflare Access protects /authorize there)
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "merit-mcp.example.com", "custom_domain": true }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MeritMCP"] }],
  "durable_objects": {
    "bindings": [{ "class_name": "MeritMCP", "name": "MCP_OBJECT" }]
  },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "<kv-namespace-id>" }],
  // Optional: Cloudflare Access app on <domain>/authorize. Without these, the page asks for ACCESS_KEY.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "<team>.cloudflareaccess.com",
    "ACCESS_AUD": "<access-application-aud>"
  },
  // Optional: more instances (another Merit company / Cloudflare account), deployed with --env <name>.
  // routes, durable_objects, kv_namespaces, migrations and vars are not inherited and must be repeated.
  "env": {
    "second": {
      "name": "merit-aktiva-mcp-second",
      "account_id": "<other-account-id>",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "merit-mcp.example.org", "custom_domain": true }],
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MeritMCP"] }],
      "durable_objects": {
        "bindings": [{ "class_name": "MeritMCP", "name": "MCP_OBJECT" }]
      },
      "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "<other-kv-namespace-id>" }],
      "vars": {
        "ACCESS_TEAM_DOMAIN": "<other-team>.cloudflareaccess.com",
        "ACCESS_AUD": "<other-access-application-aud>"
      }
    }
  }
}
